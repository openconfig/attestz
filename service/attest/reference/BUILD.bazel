load("@bazel_lib//lib:testing.bzl", "assert_archive_contains")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@tar.bzl", "mutate", "tar")

go_library(
    name = "attest_lib",
    srcs = ["main.go"],
    embed = [
        ":client_cert",
        ":verify",
    ],
    importpath = "github.com/openconfig/attestz/service/attest",
    visibility = ["//visibility:private"],
    deps = [
        "//proto:common_definitions_go_proto",
        "//proto:tpm_attestz_go",
        "@com_github_golang_glog//:glog",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

go_binary(
    name = "attest",
    embed = [":attest_lib"],
    pure = "on",
    visibility = ["//visibility:public"],
)

go_test(
    name = "attest_test",
    srcs = ["main_test.go"],
    embed = [":attest_lib"],
    deps = [
        "//proto:common_definitions_go_proto",
        "@com_github_google_go_cmp//cmp",
    ],
)

go_library(
    name = "client_cert",
    srcs = ["client_cert.go"],
    importpath = "github.com/openconfig/attestz/service/attest",
    visibility = ["//visibility:public"],
)

go_test(
    name = "client_cert_test",
    srcs = ["client_cert_test.go"],
    embed = [":client_cert"],
)

go_library(
    name = "verify",
    srcs = ["verify.go"],
    importpath = "github.com/openconfig/attestz/service/attest",
    visibility = ["//visibility:public"],
    deps = [
        "//proto:tpm_attestz_go",
        "@com_github_google_go_tpm//tpm2",
    ],
)

go_test(
    name = "verify_test",
    srcs = ["verify_test.go"],
    embed = [":verify"],
    deps = [
        "//proto:common_definitions_go_proto",
        "//proto:tpm_attestz_go",
        "@com_github_google_go_tpm//tpm2",
    ],
)

tar(
    name = "attest_layer",
    srcs = [":attest"],
    out = "attest_layer.tar",
    mutate = mutate(strip_prefix = package_name() + "/attest_"),
)

assert_archive_contains(
    name = "test_attest_layer",
    archive = "attest_layer.tar",
    expected = ["attest"],
)

oci_image(
    name = "attest_image",
    base = "@distroless_base",
    entrypoint = ["/attest"],
    tars = [":attest_layer"],
)

oci_load(
    name = "load_image",
    image = ":attest_image",
    repo_tags = ["open-config-attest:latest"],
)
