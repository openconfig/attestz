components: {
  id: "EnrollzControllerSUT"
  kind: "kubernetes"
  provided_interfaces: {
    grpc: {
      service_name: "openconfig.attestz.test.enrollz.Controller"
    }
  }
  parameters: {
    [type.googleapis.com/monax.kubernetes.KubernetesComponentParameters] {
      deployment_path: "deploy/deployment.yaml"
      service_path: "deploy/service.yaml"
      docker: {
        # Relative to this directory (points to test/enrollz root):
        context_path: "../../"
        # Relative to context_path:
        dockerfile_path: "sut/controller/deploy/Dockerfile"
        build_image: true
        load_to_kind: true
      }
    }
  }
}