load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "device_emulator_lib",
    srcs = ["device_emulator.go"],
    importpath = "github.com/openconfig/attestz/device/emulator",
    visibility = ["//visibility:public"],
    deps = [
        "//proto:common_definitions_go_proto",
        "//proto:tpm_enrollz_go",
        "@com_github_golang_glog//:glog",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
    ],
)

go_binary(
    name = "device_emulator",
    embed = [":device_emulator_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "device_emulator_test",
    srcs = ["device_emulator_test.go"],
    embed = [":device_emulator_lib"],
    deps = [
        "//proto:common_definitions_go_proto",
        "//proto:tpm_enrollz_go",
        "//service/biz:enrollz_biz",
        "@org_golang_google_grpc//:grpc",
        "@org_golang_google_grpc//credentials",
        "@org_golang_google_grpc//credentials/insecure",
    ],
)

